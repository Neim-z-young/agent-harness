{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "types": ["bun"],
    "paths": {
      "@harness/core": ["./packages/core/src"],
      "@harness/bus": ["./packages/bus/src"],
      "@harness/tool": ["./packages/tool/src"],
      "@harness/plugin": ["./packages/plugin/src"],
      "@harness/permission": ["./packages/permission/src"],
      "@harness/skill": ["./packages/skill/src"],
      "@harness/agent": ["./packages/agent/src"],
      "@harness/session": ["./packages/session/src"],
      "@harness/snapshot": ["./packages/snapshot/src"],
      "@harness/workspace": ["./packages/workspace/src"],
      "@harness/revert": ["./packages/revert/src"],
      "@harness/usage": ["./packages/usage/src"],
      "@harness/host": ["./packages/host/src"],
      "@harness/provider-mock": ["./packages/plugins/provider-mock/src"],
      "@harness/tools-builtin": ["./packages/plugins/tools-builtin/src"],
      "@harness/tools-builtin/meta": ["./packages/plugins/tools-builtin/src/meta.ts"],
      "@harness/tools-search": ["./packages/plugins/tools-search/src"],
      "@harness/tools-search/meta": ["./packages/plugins/tools-search/src/meta.ts"],
      "@harness/tools-glob": ["./packages/plugins/tools-glob/src"],
      "@harness/tools-glob/meta": ["./packages/plugins/tools-glob/src/meta.ts"],
      "@harness/tools-web": ["./packages/plugins/tools-web/src"],
      "@harness/tools-web/meta": ["./packages/plugins/tools-web/src/meta.ts"],
      "@harness/tools-media": ["./packages/plugins/tools-media/src"],
      "@harness/tools-media/meta": ["./packages/plugins/tools-media/src/meta.ts"],
      "@harness/tools-manager": ["./packages/plugins/tools-manager/src"],
      "@harness/manage-plugin": ["./packages/plugins/manage-plugin/src"],
      "@harness/code-intel": ["./packages/plugins/code-intel/src"],
      "@harness/code-intel/meta": ["./packages/plugins/code-intel/src/meta.ts"],
      "@harness/acp-context": ["./packages/plugins/acp-context/src"],
      "@harness/workspace-shell": ["./packages/plugins/workspace-shell/src"],
      "@harness/herdr": ["./packages/plugins/herdr/src"],
      "@harness/memory": ["./packages/plugins/memory/src"],
      "@harness/provider-anthropic": ["./packages/plugins/provider-anthropic/src"],
      "@harness/mcp-client": ["./packages/plugins/mcp-client/src"],
      "@harness/mcp-server-registry": ["./packages/plugins/mcp-server-registry/src"],
      "@harness/computer-use": ["./packages/plugins/computer-use/src"],
      "@harness/computer-use/meta": ["./packages/plugins/computer-use/src/meta.ts"],
      "@harness/telemetry": ["./packages/plugins/telemetry/src"],
      "@harness/cli": ["./packages/cli/src"]
    }
  },
  "include": ["packages/*/src", "packages/plugins/*/src"],
  "exclude": ["node_modules", "dist", "reference"]
}
