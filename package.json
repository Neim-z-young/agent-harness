{
  "name": "agent-harness",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "A plugin-based Agent Harness framework built with TypeScript + Bun",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "probe:cache": "bun run packages/cli/src/probe-cache-telemetry.ts",
    "gen:lm-tools": "bun run packages/cli/src/gen-lm-tools.ts"
  },
  "dependencies": {
    "@harness/a2a-server": "workspace:*",
    "@harness/agent": "workspace:*",
    "@harness/acp-context": "workspace:*",
    "@harness/bench": "workspace:*",
    "@harness/bus": "workspace:*",
    "@harness/code-intel": "workspace:*",
    "@harness/computer-use": "workspace:*",
    "@harness/coordinator": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/fs-guard": "workspace:*",
    "@harness/host": "workspace:*",
    "@harness/isolation": "workspace:*",
    "@harness/manage-plugin": "workspace:*",
    "@harness/mcp-client": "workspace:*",
    "@harness/mcp-server-registry": "workspace:*",
    "@harness/permission": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/provider-anthropic": "workspace:*",
    "@harness/provider-gemini": "workspace:*",
    "@harness/provider-glm": "workspace:*",
    "@harness/provider-mock": "workspace:*",
    "@harness/provider-openai": "workspace:*",
    "@harness/provider-qwen": "workspace:*",
    "@harness/revert": "workspace:*",
    "@harness/session": "workspace:*",
    "@harness/skill": "workspace:*",
    "@harness/snapshot": "workspace:*",
    "@harness/subagent": "workspace:*",
    "@harness/swarm": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/tools-builtin": "workspace:*",
    "@harness/tools-glob": "workspace:*",
    "@harness/tools-manager": "workspace:*",
    "@harness/tools-media": "workspace:*",
    "@harness/tools-search": "workspace:*",
    "@harness/tools-web": "workspace:*",
    "@harness/telemetry": "workspace:*",
    "@harness/usage": "workspace:*",
    "@harness/workspace": "workspace:*",
    "@harness/workspace-shell": "workspace:*",
    "acp-kernel": "^0.0.63"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
