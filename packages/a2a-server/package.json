{
  "name": "@harness/a2a-server",
  "version": "0.1.0",
  "description": "A2A（Agent2Agent）服务端宿主：把 @harness/host 的装配暴露为 A2A v1.0 协议服务（AgentCard / SendMessage / SendStreamingMessage / GetTask / CancelTask）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@harness/agent": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/host": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/session": "workspace:*",
    "@harness/usage": "workspace:*"
  },
  "devDependencies": {
    "@harness/provider-mock": "workspace:*"
  }
}
