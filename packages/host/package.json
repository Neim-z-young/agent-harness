{
  "name": "@harness/host",
  "version": "0.1.0",
  "description": "宿主装配层：外部插件目录加载等与宿主无关的装配原语（CLI / A2A server / VSCode 扩展共用一份装配）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@harness/plugin": "workspace:*",
    "@harness/workspace": "workspace:*"
  }
}
