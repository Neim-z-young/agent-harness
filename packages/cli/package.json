{
  "name": "@harness/cli",
  "version": "0.1.0",
  "description": "Agent Harness 命令行入口：交互式 REPL、会话持久化、权限交互",
  "type": "module",
  "bin": {
    "harness": "./src/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/agent": "workspace:*",
    "@harness/bus": "workspace:*",
    "@harness/coordinator": "workspace:*",
    "@harness/core": "workspace:*",
    "@harness/permission": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/provider-anthropic": "workspace:*",
    "@harness/provider-gemini": "workspace:*",
    "@harness/provider-glm": "workspace:*",
    "@harness/provider-mock": "workspace:*",
    "@harness/provider-openai": "workspace:*",
    "@harness/provider-qwen": "workspace:*",
    "@harness/revert": "workspace:*",
    "@harness/session": "workspace:*",
    "@harness/skill": "workspace:*",
    "@harness/snapshot": "workspace:*",
    "@harness/subagent": "workspace:*",
    "@harness/swarm": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/tools-builtin": "workspace:*",
    "@harness/tools-manager": "workspace:*",
    "@opentui/core": "^0.5.8",
    "@opentui/react": "^0.5.8",
    "react": "^19.2.8"
  },
  "scripts": {
    "dev": "bun run ./src/index.ts repl",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run ./src/index.ts repl",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
