{
  "name": "@harness/computer-use",
  "version": "0.1.0",
  "description": "电脑控制 MCP server 插件：依赖 mcp-server-registry 自动启动进程内 MCP server，用 macOS 自动化（osascript）实现电脑操作",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/mcp-server-registry": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/skill": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}