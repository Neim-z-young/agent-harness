{
  "name": "@harness/code-intel",
  "version": "0.5.0",
  "description": "代码情报插件：code_symbols / code_reference / code_definition + code_semantic_edit（rename scope 限定/replace_node/replace_subtree 批量）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts"
    }
  },
  "dependencies": {
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@types/babel__traverse": "^7.20.6"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
