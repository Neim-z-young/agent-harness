{
  "name": "@harness/code-intel",
  "version": "0.10.0",
  "description": "代码情报插件：code_symbols / code_reference / code_definition + code_semantic_edit（rename scope/跨目录反向import/replace_node/replace_subtree 批量）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts"
    }
  },
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@harness/plugin": "workspace:*",
    "@harness/tool": "workspace:*",
    "@types/babel__traverse": "^7.20.6",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "web-tree-sitter": "^0.27.0"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun scripts/copy-grammars.mts && bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
