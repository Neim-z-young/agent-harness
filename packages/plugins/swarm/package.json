{
  "name": "@harness/swarm",
  "version": "0.1.0",
  "description": "Swarm 插件：显式 Team 实体 + Mailbox 文件收件箱 + Task List 任务平面 + Leader 权限桥 + in-process teammate（参考 Claude Code swarm）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/core": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/agent": "workspace:*",
    "@harness/session": "workspace:*",
    "@harness/bus": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
