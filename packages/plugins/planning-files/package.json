{
  "name": "@harness/planning-files",
  "version": "0.1.0",
  "description": "文件化持久规划插件：计划放磁盘（.planning/ 三文件），每轮经 core.session.preModel 尾部注入，跨会话 / 压缩 / 崩溃存活",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/plugin": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
