{
  "name": "@harness/tools-search",
  "version": "0.1.0",
  "description": "搜索类工具插件：list_dir 目录列举 + grep_file 内容检索",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts"
    }
  },
  "dependencies": {
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/bus": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
