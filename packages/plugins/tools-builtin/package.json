{
  "name": "@harness/tools-builtin",
  "version": "0.1.0",
  "description": "内置 Tool 插件：read_file / write_file / bash 三件套",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts"
    }
  },
  "dependencies": {
    "@harness/core": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/bus": "workspace:*",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.27.0"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
