{
  "name": "@harness/tools-media",
  "version": "0.1.0",
  "description": "媒体类工具插件：view_image 读取本地图像为 base64（供多模态 LLM 识别）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts"
    }
  },
  "dependencies": {
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/bus": "workspace:*",
    "@harness/fs-guard": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
