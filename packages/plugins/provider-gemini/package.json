{
  "name": "@harness/provider-gemini",
  "version": "0.1.0",
  "description": "Google Gemini Provider 插件：对接 Generative Language API（generateContent / streamGenerateContent），支持 Tool Use 与流式输出",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/core": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/session": "workspace:*",
    "@harness/bus": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
