{
  "name": "@harness/memory",
  "version": "0.1.0",
  "description": "长期记忆插件：加载两级记忆索引与项目指令，注入 system prompt，并提供 /memory 命令",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/plugin": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@harness/core": "workspace:*",
    "@harness/workspace": "workspace:*"
  }
}
