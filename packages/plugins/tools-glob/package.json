{
  "name": "@harness/tools-glob",
  "version": "0.1.0",
  "description": "Glob 搜索工具插件：glob 按模式匹配查找文件（含排除/大小/时间过滤）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./src/meta.ts"
    }
  },
  "dependencies": {
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/bus": "workspace:*",
    "@harness/fs-guard": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
