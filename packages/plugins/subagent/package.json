{
  "name": "@harness/subagent",
  "version": "0.1.0",
  "description": "Subagent 插件：让主 Agent 能派出子 Agent 执行独立任务（隔离 session + 独立工具白名单）",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/core": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*",
    "@harness/agent": "workspace:*",
    "@harness/session": "workspace:*",
    "@harness/bus": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
