{
  "name": "@harness/mcp-server-registry",
  "version": "0.1.0",
  "description": "MCP Server 注册表插件：所有 mcpserver 相关插件依赖它启动 server，并通过 @harness/mcp-client 管理连接",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@harness/mcp-client": "workspace:*",
    "@harness/tool": "workspace:*",
    "@harness/plugin": "workspace:*"
  },
  "scripts": {
    "dev": "tsc --noEmit --watch",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}